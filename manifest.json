{
  "manifest_version": 3,
  "name": "Tab Sweeper",
  "description": "Automatically closes tabs whose URL matches your patterns.",
  "version": "1.0.0",
  "permissions": ["tabs", "storage", "webNavigation"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Sweeper"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
